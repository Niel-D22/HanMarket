PORT=8080
LOG_LEVEL=info

# Robinhood Chain RPCs (third-party public endpoints; *.robinhood.com is blocked by some ISPs)
ROBINHOOD_TESTNET_RPC=https://robinhood-sepolia-rpc.publicnode.com
ROBINHOOD_MAINNET_RPC=https://robinhood-rpc.publicnode.com

# Deployed protocol, one JSON per network, exactly as printed by contracts/script/Deploy.s.sol
# (the web app reads the same JSON from VITE_TESTNET_DEPLOYMENT / VITE_MAINNET_DEPLOYMENT)
TESTNET_DEPLOYMENT=
MAINNET_DEPLOYMENT=

# Keeper: settles expired options (KEEPER_CRON), opens/closes perp sessions and liquidates (every minute).
# Pays the gas, and must be the keeper set in RiskManager and OptionsEngine. Leave empty to disable.
KEEPER_PRIVATE_KEY=
KEEPER_CRON=*/5 * * * *
# Signs settlement prices for assets without a Chainlink feed. Its address must equal OracleRouter.priceSigner.
PRICE_SIGNER_KEY=

# Pyth Hermes API key (https://docs.pyth.network). Without it, prices fall back to Yahoo Finance.
PYTH_API_KEY=
PYTH_HERMES_URL=https://hermes.pyth.network

# Optional: borrow quotes from a deployed HanMarket API where robinhood.com is blocked by the local network.
PRICES_URL=
