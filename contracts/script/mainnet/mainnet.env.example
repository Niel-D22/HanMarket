# HanMarket mainnet deployment inputs. Copy to mainnet.env (same folder) and fill in.
# Addresses only: this file never holds a private key. The deployer signs with a Foundry keystore
# (cast wallet import hanmarket-deployer --interactive) or a Ledger, never a key pasted into a file.
# deploy-mainnet.sh check reads every value below and stops on anything that looks wrong.

# ---- network
MAINNET_RPC=https://robinhood.drpc.org
EXPECTED_CHAIN_ID=4663

# ---- the deployer: a NEW wallet for mainnet, never the testnet one. It only pays gas and hands everything to OWNER.
DEPLOYER_ACCOUNT=hanmarket-deployer
DEPLOYER_ADDRESS=
# the deploy costs about 0.0016 ETH at 0.04 gwei (measured on a fork); keep a margin for gas spikes
MIN_DEPLOYER_ETH=0.003

# ---- roles
# OWNER and TREASURY: the Safe multisig (npm run deploy:safe in api/). The deploy refuses a plain wallet here.
OWNER=
TREASURY=
# KEEPER: the keeper's own key (Railway), not the owner's. It lists option series and opens/closes perp sessions.
KEEPER=
# PRICE_SIGNER signs settlement prices for assets without Chainlink; QUOTE_SIGNER signs option quotes (Vercel).
PRICE_SIGNER=
QUOTE_SIGNER=

# ---- external contracts: re-check both on the explorer on launch day
# USDG (Global Dollar, Paxos), Robinhood Chain's native stablecoin, 6 decimals
USDC_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Chainlink "Robinhood BABA / USD", 8 decimals
BABA_FEED=0x62Cc8F9b5f56a33c9C8A60c8B92779f523c4E984

# ---- risk: a decision, not a default. Size the caps to the capital that will actually sit in the vault.
# Leverage: 3x with 33.34% / 10% margins (the script's default), or 10x with 1000 / 500 as on testnet.
PERP_MAX_LEVERAGE=3
PERP_INITIAL_MARGIN_BPS=3334
PERP_MAINTENANCE_MARGIN_BPS=1000
# whole dollars. Example for a $2,000 launch pool: one position up to $500, $1,500 open per side,
# up to $1,000 reserved for any one stock's options, positions may reserve 80% of the pool.
PERP_MAX_POSITION=500
PERP_OI_CAP=1500
OPTIONS_RESERVE_CAP=1000
MAX_UTILIZATION_BPS=8000
