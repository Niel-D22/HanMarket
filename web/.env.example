VITE_API_URL=http://localhost:8080/api
# Link X/Twitter (opsional). Kosong = memakai https://x.com/HANMARKETS (web/src/config/social.ts); tampil di header, footer landing, dan top bar terminal
VITE_X_URL=
# Deployed HanMarket protocol, one JSON per network, exactly as printed at the end of contracts/script/Deploy.s.sol
# (empty = not deployed yet; the terminal then shows prices and charts with trading disabled)
VITE_TESTNET_DEPLOYMENT=
VITE_MAINNET_DEPLOYMENT=
# Server-side only (Vercel env, never VITE_): signs option quotes in /api/options/quote.
# Its address must equal OptionsEngine.quoteSigner.
QUOTE_SIGNER_KEY=
# Mainnet quotes are signed with their own key (QUOTE_SIGNER in contracts/script/mainnet/mainnet.env); no fallback.
MAINNET_QUOTE_SIGNER_KEY=
# Optional, free from cloud.reown.com: enables mobile wallets / QR login
VITE_WALLETCONNECT_PROJECT_ID=
# Server-side only (Vercel env, never VITE_): private RPC behind /api/rpc, e.g. an Alchemy Robinhood Chain URL. The browser
# reads through /api/rpc first and the public RPCs after it, so the key never reaches the bundle. Empty = public RPCs only.
# Locally, run `npm run dev:api` with these set and start the dev server with VITE_API_PROXY=http://localhost:8787.
# History and Options Flow always read events from the public RPCs: Alchemy's free plan caps eth_getLogs at 10 blocks.
TESTNET_RPC_URL=
MAINNET_RPC_URL=
